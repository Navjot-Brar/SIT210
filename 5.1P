import tkinter as tk
import RPi.GPIO as GPIO

# GPIO pins for the three room lights
GPIO.setmode(GPIO.BOARD)

living_led = 11
bathroom_led = 13
closet_led = 15

GPIO.setup(living_led, GPIO.OUT)
GPIO.setup(bathroom_led, GPIO.OUT)
GPIO.setup(closet_led, GPIO.OUT)

# Start with all LEDs switched off
GPIO.output(living_led, GPIO.LOW)
GPIO.output(bathroom_led, GPIO.LOW)
GPIO.output(closet_led, GPIO.LOW)


# Switch off all LEDs
def turn_all_off():
    GPIO.output(living_led, GPIO.LOW)
    GPIO.output(bathroom_led, GPIO.LOW)
    GPIO.output(closet_led, GPIO.LOW)


# Turn on the LED selected by the user
def select_room(led_pin):
    turn_all_off()
    GPIO.output(led_pin, GPIO.HIGH)


# Close the program safely
def close_program():
    turn_all_off()
    GPIO.cleanup()
    window.destroy()


# Create the GUI window
window = tk.Tk()
window.title("Room Light Control")
window.geometry("300x250")

title = tk.Label(window, text="Select a Room")
title.pack(pady=10)

# Stores which radio button is selected
selected_room = tk.IntVar()

living_button = tk.Radiobutton(
    window,
    text="Living Room",
    variable=selected_room,
    value=living_led,
    command=lambda: select_room(living_led)
)
living_button.pack()

bathroom_button = tk.Radiobutton(
    window,
    text="Bathroom",
    variable=selected_room,
    value=bathroom_led,
    command=lambda: select_room(bathroom_led)
)
bathroom_button.pack()

closet_button = tk.Radiobutton(
    window,
    text="Closet",
    variable=selected_room,
    value=closet_led,
    command=lambda: select_room(closet_led)
)
closet_button.pack()

exit_button = tk.Button(
    window,
    text="Exit",
    command=close_program
)
exit_button.pack(pady=20)

# Keep the window open
window.mainloop()
