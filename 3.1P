#include <WiFiNINA.h>
#include <PubSubClient.h>
#include <Wire.h>
#include <BH1750.h>

#define WIFI_SSID "Karan Cheema"
#define WIFI_PASSWORD "karan@2007"

// HiveMQ details
#define MQTT_SERVER "140e92a9ed11470c9de22fea12bc395d.s1.eu.hivemq.cloud"
#define MQTT_PORT 8883
#define MQTT_TOPIC "sensor/light"
#define MQTT_USER "krn_cheema"
#define MQTT_PASSWORD "12345678"

WiFiSSLClient wifiSSLClient;
PubSubClient mqttClient(wifiSSLClient);
BH1750 lightMeter;

// This connects the Arduino to HiveMQ
void connectMQTT() {
  while (!mqttClient.connected()) {
    Serial.println("Connecting to MQTT...");
    
    if (mqttClient.connect("ArduinoNanoIoT", MQTT_USER, MQTT_PASSWORD)) {
      Serial.println("Connected to HiveMQ Broker!");
    } else {
      Serial.print("Failed, rc=");
      Serial.print(mqttClient.state());
      Serial.println(" Retrying in 5 seconds...");
      delay(5000);
    }
  }
}

void setup() {
  Serial.begin(9600);

  // Wait until the Serial Monitor is ready
  while (!Serial);

  Wire.begin();

  // Start the BH1750 sensor
  if (lightMeter.begin()) {
    Serial.println(F("BH1750 initialized"));
  } else {
    Serial.println(F("Error initializing BH1750"));
  }

  Serial.print("Connecting to WiFi");

  // Connect to the WiFi
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.print(".");
  }

  Serial.println("\nConnected to WiFi");

  // Set the HiveMQ server
  mqttClient.setServer(MQTT_SERVER, MQTT_PORT);

  // Connect to the MQTT broker
  connectMQTT();
}

void loop() {

  // Reconnect if MQTT gets disconnected
  if (!mqttClient.connected()) {
    connectMQTT();
  }

  mqttClient.loop();

  // Get the current light level from the BH1750
  float lux = lightMeter.readLightLevel();

  // Show the reading in Serial Monitor
  Serial.print("Light: ");
  Serial.print(lux);
  Serial.println(" lx");

  // Change the lux value into text for MQTT
  String message = String(lux, 2);

  // Send the light value to HiveMQ
  if (mqttClient.connected()) {

    if (mqttClient.publish(MQTT_TOPIC, message.c_str())) {
      Serial.print("Published to ");
      Serial.print(MQTT_TOPIC);
      Serial.print(": ");
      Serial.println(message);
    } else {
      Serial.println("MQTT publish failed!");
    }
  }

  // Wait before taking the next reading
  delay(3000);
}
